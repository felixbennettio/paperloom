{
  "$schema": "https://schema.tauri.app/config/2",
  "build": { "beforeBuildCommand": "npm run build && npm run build:wps" },
  "bundle": {
    "resources": { "../dist-wps/": "wps-addin/", "../dist-word/": "word-addin/" },
    "fileAssociations": [
      { "ext": ["ris"], "name": "RIS", "description": "RIS reference file", "role": "Viewer" },
      { "ext": ["enw"], "name": "EndNote", "description": "EndNote reference file", "role": "Viewer" },
      { "ext": ["nbib"], "name": "PubMed", "description": "PubMed reference file", "role": "Viewer" }
    ]
  }
}
