# Rust
/target/
**/target/

# Node / UI
node_modules/
dist/
dist-addin/
dist-wps/
dist-word/
*.tsbuildinfo
.vite/

# Tauri generated
app/src-tauri/gen/schemas/

# THIRD_PARTY_NOTICES, written by scripts/licenses.py at build time
app/public/THIRD_PARTY_NOTICES.txt
apple/Paperloom/Resources/THIRD_PARTY_NOTICES.txt

# The Word add-in's manifest, written by scripts/word-manifest.py at build time
apple/Paperloom/Resources/WordAddinManifest.xml

# Apple (the Xcode project is generated by XcodeGen from apple/project.yml)
apple/*.xcodeproj/
apple/*.xcworkspace/
apple/build/
apple/CoreKit/Frameworks/
apple/CoreKit/Sources/CoreKit/Generated/
xcuserdata/
DerivedData/
*.xcarchive

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Secrets never belong in the repository
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks
.env
.env.*

# Generated by the Tauri CLI in CI (`tauri icon`, `tauri android init`)
app/src-tauri/icons/
app/src-tauri/gen/
# Copied in by the Tauri plugin build (Android library, permissions)
app/src-tauri/plugins/*/android/.tauri/
app/src-tauri/plugins/*/permissions/
