    "Formats are Moment.js patterns, as in Obsidian, which shares these settings with this vault.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les formats suivent Moment.js, comme dans Obsidian, qui partage ces réglages avec ce coffre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形式は Obsidian と同じ Moment.js の書き方です。これらの設定は Obsidian と共有されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форматы — шаблоны Moment.js, как в Obsidian, который использует эти же настройки хранилища."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格式使用 Moment.js 写法，与 Obsidian 相同；这些设置与 Obsidian 共用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "格式使用 Moment.js 寫法，與 Obsidian 相同；這些設定與 Obsidian 共用。"
          }
        }
      }
