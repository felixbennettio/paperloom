    "Keys stay on this device and go only to their database. What you find depends on your subscription.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés restent sur cet appareil et ne sont envoyées qu’à leur base. Ce que vous trouvez dépend de votre abonnement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはこのデバイスにのみ保存され、それぞれのデータベースにだけ送信されます。検索できる内容は購読契約によって異なります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи хранятся только на этом устройстве и передаются только своей базе. Доступные результаты зависят от вашей подписки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥只保存在本设备上，只发送给对应的数据库。能检索到的内容取决于你的订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰只保存在本裝置上，只傳送給對應的資料庫。能檢索到的內容取決於你的訂閱。"
          }
        }
      }
    },
