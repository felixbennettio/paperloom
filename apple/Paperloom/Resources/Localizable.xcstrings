    "Styles come from the CSL style repository, the one Zotero uses, and are kept beside the library on this device.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les styles viennent du dépôt de styles CSL, celui qu’utilise Zotero, et sont gardés à côté de la bibliothèque sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタイルは CSL スタイルリポジトリ（Zotero と同じもの）から取得し、この端末のライブラリの隣に保存します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стили берутся из репозитория стилей CSL (того же, что у Zotero) и хранятся рядом с библиотекой на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "样式来自 CSL 样式库（Zotero 使用的同一个），保存在本设备上的文库旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "樣式來自 CSL 樣式庫（Zotero 使用的同一個），儲存在本裝置上的文庫旁邊。"
          }
        }
      }
    },
