    "What the note says now is kept as a version too.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu actuel de la note est aussi gardé comme version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
