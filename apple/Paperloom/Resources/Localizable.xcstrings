    "Each plugin runs apart from the app and asks before it reaches a website.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque module s’exécute à part de l’app et demande avant d’accéder à un site."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各プラグインはアプリから隔離されて動作し、ウェブサイトに接続する前に確認します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый плагин работает отдельно от приложения и спрашивает перед обращением к сайту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个插件都与 App 隔离运行，访问网站前会先征得你同意。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個外掛都與 App 隔離執行，存取網站前會先徵得你同意。"
          }
        }
      }
    },
    "Each plugin runs apart from the app and asks before it reaches a website. Turning one on or off here does the same in Obsidian.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque module s’exécute à part de l’app et demande avant d’accéder à un site. L’activer ou le désactiver ici fait de même dans Obsidian."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各プラグインはアプリから隔離されて動作し、ウェブサイトに接続する前に確認します。ここでのオン／オフは Obsidian にも反映されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый плагин работает отдельно от приложения и спрашивает перед обращением к сайту. Включение или выключение здесь действует и в Obsidian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个插件都与 App 隔离运行，访问网站前会先征得你同意。在此启用或停用插件，Obsidian 中也会同步生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個外掛都與 App 隔離執行，存取網站前會先徵得你同意。在此啟用或停用外掛，Obsidian 中也會同步生效。"
          }
        }
      }
    },
