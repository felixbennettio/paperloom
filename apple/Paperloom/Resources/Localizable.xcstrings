    "Connect to search your library. Paperloom will ask you to allow this task pane.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour rechercher dans votre bibliothèque. Paperloom vous demandera d’autoriser ce volet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続するとライブラリを検索できます。Paperloom でこの作業ウィンドウの接続許可を求められます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь для поиска в библиотеке. Paperloom попросит разрешить подключение этой панели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接后即可搜索文库。织卷会询问你是否允许此任务窗格连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線後即可搜尋文庫。織卷會詢問你是否允許此工作窗格連線。"
          }
        }
      }
    },
    "Connected writing plugins can search the library and format citations.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modules d’écriture connectés peuvent chercher dans la bibliothèque et mettre en forme les citations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済みの執筆プラグインは、ライブラリを検索して引用を整形できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключённые плагины для текстов могут искать в библиотеке и оформлять ссылки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接的写作插件可以搜索文库并排版引文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連接的寫作外掛可以搜尋文庫並排版引文。"
          }
        }
      }
    },
