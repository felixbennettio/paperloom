    },
    "The answer stops early: it reached the length limit.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse s’arrête tôt : elle a atteint la limite de longueur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答は長さの上限に達したため途中で終わっています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ оборвался: достигнут предел длины."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答到达长度上限，提前结束了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回答到達長度上限，提前結束了。"
          }
        }
      }
    },
    "The connection was declined in Paperloom. You can try again.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été refusée dans Paperloom. Vous pouvez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Paperloom で接続が拒否されました。もう一度お試しいただけます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение отклонено в Paperloom. Можно повторить попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接请求已在织卷中被拒绝。你可以重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
