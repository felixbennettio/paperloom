    "No earlier versions yet. Before a note changes, it is kept as it was, at most every five minutes.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de version antérieure. Avant qu’une note change, elle est gardée telle quelle, au plus toutes les cinq minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ以前のバージョンはありません。ノートが変わる前の状態を、最大で5分ごとに保存します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ранних версий пока нет. Перед изменением заметка сохраняется как была, не чаще раза в пять минут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有历史版本。笔记改动之前会保留原样，最多每五分钟一份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有歷史版本。筆記改動之前會保留原樣，最多每五分鐘一份。"
          }
        }
      }
    },
