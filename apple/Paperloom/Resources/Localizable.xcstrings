    "Paperloom puts the add-in in the “wef” folder of Word's Documents folder. Choose that folder, or Word's Documents folder, to install it.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paperloom place le complément dans le dossier « wef » du dossier Documents de Word. Choisissez ce dossier, ou le dossier Documents de Word, pour l’installer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Paperloom はアドインを Word の Documents フォルダ内の「wef」フォルダに置きます。インストールするには、そのフォルダか Word の Documents フォルダを選んでください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Paperloom помещает надстройку в папку «wef» в папке Documents программы Word. Чтобы установить её, выберите эту папку или папку Documents программы Word."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "织卷会把插件放进 Word 的 Documents 文件夹里的“wef”文件夹。选择这个文件夹或 Word 的 Documents 文件夹即可安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "織卷會把外掛放進 Word 的 Documents 資料夾裡的「wef」資料夾。選擇這個資料夾或 Word 的 Documents 資料夾即可安裝。"
          }
        }
      }
    },
