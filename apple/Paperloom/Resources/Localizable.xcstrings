        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les mots doivent apparaître ; utilisez des \"guillemets\" pour une expression et -mot pour en exclure un."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての語を含む結果を表示します。\"引用符\" で語句を、-語 で除外を指定できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Должны встречаться все слова; \"кавычки\" — для фразы, -слово — чтобы исключить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有词都需出现；用 \"引号\" 搜索短语，用 -词 排除某个词。"
