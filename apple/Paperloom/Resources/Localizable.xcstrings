    "Works added: %@; already in the library: %@.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Références ajoutées : %@ ; déjà dans la bibliothèque : %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 件の文献を追加しました（%@ 件は既存）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлено записей: %@; уже в библиотеке: %@."
          }
        },
        "zh-Hans": {
