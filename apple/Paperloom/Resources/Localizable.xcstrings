    "Items in the trash, with their files and annotations, are deleted for good.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les références de la corbeille, avec leurs fichiers et annotations, seront supprimées définitivement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱内の文献は、ファイルや注釈とともに完全に削除されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публикации в корзине вместе с файлами и пометками будут удалены навсегда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓中的文献及其文件和批注将被永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾桶中的文獻及其檔案和批註將被永久刪除。"
          }
        }
      }
    },
