    "It can then search your library and format the citations in your documents. It cannot change the library.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pourra alors chercher dans votre bibliothèque et mettre en forme les citations de vos documents. Il ne peut pas modifier la bibliothèque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリを検索し、文書内の引用を整形できるようになります。ライブラリを変更することはできません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тогда оно сможет искать в вашей библиотеке и оформлять ссылки в документах. Изменять библиотеку оно не может."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将可以搜索你的文库，并为你的文档排版引用，但不能修改文库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它將可以搜尋你的文庫，並為你的文件排版引用，但不能修改文庫。"
          }
        }
      }
    },
