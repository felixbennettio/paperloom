    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paperloom records audio into your notes when you ask it to."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paperloom enregistre l’audio dans vos notes quand vous le lui demandez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指示があったとき、Paperloom はノートに録音します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Paperloom записывает звук в заметки, когда вы об этом просите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你要求时，织卷会把录音保存到笔记中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你要求時，織卷會把錄音儲存到筆記中。"
          }
        }
      }
    }
